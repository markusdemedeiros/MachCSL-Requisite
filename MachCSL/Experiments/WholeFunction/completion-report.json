  "final_contract_audit": {
    "source": ".lake/whole-function/FinalIntegrationAudit.lean",
    "source_text": "import Xv6.ReadiParts\nimport Xv6.DinodeSlot\nimport Xv6.SpecEitherCopyout\nimport Xv6.BlkmapBuf\nimport Experiments.ResourcePlanner.Actual\nimport Lean.Util.CollectAxioms\nimport Xv6.LinkCopyin\nimport Xv6.LinkCopyout\nimport Experiments.WholeFunction.StrlenComplete\nimport Experiments.WholeFunction.StrncpyComplete\nimport Lean.Util.CollectAxioms\n\nexample : Xv6.WALKADDR \u2192 Xv6.VMFAULT \u2192 Xv6.MEMMOVE \u2192 Xv6.COPYIN := Xv6.copyin_proof\nexample : Xv6.WALKADDR \u2192 Xv6.VMFAULT \u2192 Xv6.MEMMOVE \u2192 Xv6.COPYIN := Xv6.Copyin\nexample : Xv6.COPYIN := Xv6.CopyinClosed\nexample : Xv6.WALKADDR \u2192 Xv6.VMFAULT \u2192 Xv6.WALK_NOALLOC \u2192 Xv6.MEMMOVE \u2192 Xv6.COPYOUT := Xv6.copyout_proof\nexample : Xv6.WALKADDR \u2192 Xv6.VMFAULT \u2192 Xv6.WALK_NOALLOC \u2192 Xv6.MEMMOVE \u2192 Xv6.COPYOUT := Xv6.Copyout\nexample : Xv6.COPYOUT := Xv6.CopyoutClosed\nexample : Xv6.STRLEN := Xv6.WholeFunction.Strlen.compiled_strlen\nexample : Xv6.STRNCPY := Xv6.WholeFunction.Strncpy.compiled_strncpy\n\nopen Lean in\nrun_cmd do\n  let checks := #[\n    (``Xv6.copyin_proof, \".lake/whole-function/upstream-copyin-axioms.txt\", \"copyin\"),\n    (``Xv6.copyout_proof, \".lake/whole-function/upstream-copyout-axioms.txt\", \"copyout\"),\n    (``Xv6.WholeFunction.Strlen.compiled_strlen, \".lake/whole-function/strings/strlen-baseline-axioms.txt\", \"strlen\"),\n    (``Xv6.WholeFunction.Strncpy.compiled_strncpy, \".lake/whole-function/strings/strncpy-baseline-axioms.txt\", \"strncpy\")]\n  for (decl, file, label) in checks do\n    let original := (\u2190 IO.FS.readFile file).splitOn \"\\n\" |>.filter (\u00b7 != \"\")\n    let axioms \u2190 collectAxioms decl\n    let extra := axioms.filter fun a => !original.contains a.toString\n    unless extra.isEmpty do throwError \"{decl}: new axiom dependencies {extra}\"\n    if axioms.contains ``sorryAx then throwError \"{decl}: incomplete proof\"\n    IO.FS.writeFile s!\".lake/whole-function/completion-{label}-axioms.txt\"\n      (String.intercalate \"\\n\" (axioms.toList.map toString) ++ \"\\n\")\n    logInfo m!\"{decl}: original public contract, {axioms.size} axioms within original {original.length}.\"\n\nnamespace RootResourceAudit\nopen Iris Iris.ProgramLogic Iris.BI Iris.ProofMode Std MachCSL Xv6 LeanRV64D\nset_option linter.unusedSimpArgs false\nvariable {hlc : HasLC} {GF : BundledGFunctors} [MachGS hlc GF] [Xv6G GF] [FdslotG GF] [BioslotG GF] [IrefslotG GF] [CtokG GF] [WchG GF] [BcacheG GF]\n  [DiskG GF] [FsBlocksG GF] [SleepLockG GF] [CurCtx]\n\ntheorem replacement_contract (\u03b3b : BcacheNames) (V : BioView GF) (kk : Nat) (pidv dev bno : BitVec 32)\n    (bs bsd : List (BitVec 8)) (o m : Nat) (ho : o + m \u2264 BSIZE) :\n    bufHold0 (GF := GF) \u03b3b V kk pidv dev bno bs bsd \u22a2\n      iprop(\u231cbs.length = BSIZE\u231d \u2217\n        byteBuf (bnode kk + (88#64 + BitVec.ofNat 64 o)) (DFrac.own 1) ((bs.drop o).take m) \u2217\n        (byteBuf (bnode kk + (88#64 + BitVec.ofNat 64 o)) (DFrac.own 1) ((bs.drop o).take m) -\u2217\n          bufHold0 \u03b3b V kk pidv dev bno bs bsd))  := by\n  exact Experiments.ResourcePlanner.Actual.readi_hold_window \u03b3b V kk pidv dev bno bs bsd o m ho\n\nopen Lean in\nrun_cmd do\n  let axs \u2190 collectAxioms ``replacement_contract\n  let baseline := (\u2190 IO.FS.readFile \".lake/resource-planner/root-original-axioms.txt\").splitOn \"\\n\"\n  unless axs.all (fun a => baseline.contains a.toString) do\n    throwError \"Replacement added axioms: {axs}\"\n  if axs.contains ``sorryAx then throwError \"incomplete replacement\"\n  if (\u2190 getEnv).contains `Xv6.rd_hold_win then throwError \"Original boundary proof imported\"\n  logInfo m!\"Exact original contract with original minimal instances; {axs.size} baseline axioms.\"\n#print axioms replacement_contract\nend RootResourceAudit\n",
    "log": ".lake/whole-function/final-integration-audit.log",
